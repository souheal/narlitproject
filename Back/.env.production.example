# ─────────────────────────────────────────────────────────────────────────────
# Production env for Railway. Copy the values below into the Railway
# dashboard (Project → Variables) — DO NOT commit the real .env.production.
#
# Railway auto-injects DATABASE_URL and PORT when you add the Postgres plugin;
# we still set DB_CONNECTION=pgsql so Laravel picks the right driver.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=NarLit
APP_ENV=production
APP_DEBUG=false
# Generate once: `php artisan key:generate --show` and paste the output here.
APP_KEY=
# Public URL of this backend (set after the first deploy, e.g. https://narlit-api.up.railway.app)
APP_URL=
# Public URL of the frontend on Vercel (e.g. https://narlit.vercel.app)
FRONTEND_URL=
# Comma-separated list of allowed origins for CORS. Include the Vercel URL plus
# any custom domains once they exist.
CORS_ALLOWED_ORIGINS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
AUTH_OTP_EXPIRES_MINUTES=1440
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Railway Postgres: use DB_CONNECTION=pgsql; the plugin injects DATABASE_URL
# which Laravel parses via `url => env('DB_URL')` — or set the pieces manually.
DB_CONNECTION=pgsql
DB_URL=${{Postgres.DATABASE_URL}}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Mail — use any SMTP provider (Mailgun, Postmark, Resend, Gmail app password…)
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Stripe — real keys for live, test keys for staging.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_FAKE_CHECKOUT=false
STRIPE_CHECKOUT_SUCCESS_URL=${FRONTEND_URL}/billing/success
STRIPE_CHECKOUT_CANCEL_URL=${FRONTEND_URL}/billing/cancel

IRS_VERIFICATION_MODE=local
IRS_ALLOW_LOCAL_MATCH=true
IRS_NAME_MATCH_THRESHOLD=90
